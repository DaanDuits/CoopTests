.unity-tab-view {
    height: 100%;
}

#unity-tab-view__content-container {
    height: 100%;
}

#unity-tab-view__header-container {
    display: none;
}

.unity-tab {
    height: 100%;
}

#unity-tab__content-container {
    height: 100%;
    justify-content: center;
}

#main-menu {
    left: 2%;
    width: 500px;
}

#title {
    -unity-text-align: middle-center;
    font-size: 42px;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.main-menu-button {
    margin-bottom: 5px;
    font-size: 18px;
    width: 80%;
    align-self: center;
    height: 60px;
    padding-bottom: 20px;
    padding-top: 20px;
    flex-grow: 1;
    background-color: rgb(178, 178, 178);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(153, 153, 153);
    border-right-color: rgb(153, 153, 153);
    border-top-color: rgb(153, 153, 153);
    border-bottom-color: rgb(153, 153, 153);
    -unity-font-style: bold;
}

.hosting-tab {
    justify-content: center;
}

.hosting-tab > #unity-tab__content-container {
    align-self: auto;
    align-items: center;
}

.server-tab {
    background-color: rgb(63, 63, 63);
    height: 540px;
    width: 960px;
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-left-color: rgb(22, 22, 22);
    border-right-color: rgb(22, 22, 22);
    border-top-color: rgb(22, 22, 22);
    border-bottom-color: rgb(22, 22, 22);
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
}

.server-tab-title {
    -unity-text-align: middle-center;
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(217, 217, 217);
    margin-top: 20px;
}

.session-settings {
    width: 60%;
    align-self: center;
    justify-content: center;
}

.start-session-button {
    margin-bottom: 20px;
    width: 60%;
    align-self: center;
    border-left-color: rgb(153, 153, 153);
    border-right-color: rgb(153, 153, 153);
    border-top-color: rgb(153, 153, 153);
    border-bottom-color: rgb(153, 153, 153);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgb(178, 178, 178);
    -unity-font-style: bold;
    font-size: 24px;
    height: 80px;
}

.session-settings Label {
    color: rgb(217, 217, 217);
    -unity-font-style: bold;
    font-size: 22px;
}

.session-settings VisualElement {
    justify-content: center;
}

.session-settings TextInput {
    width: 50%;
    flex-shrink: 0;
    position: absolute;
    right: 0;
}
